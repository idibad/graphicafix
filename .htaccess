# ============================================================
# Graphicafix - Apache .htaccess
# ============================================================

# Disable directory browsing
Options -Indexes

# Protect sensitive files
<FilesMatch "^\.|\.env$|composer\.(json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /graphicafix/

    # --------------------------------------------------------------
    # 1. Allow real files and directories to pass through
    # --------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --------------------------------------------------------------
    # 2. Clean URL → Subfolder routing
    # --------------------------------------------------------------

    # Pages
    RewriteRule ^(about|career|contact|portfolio|privacy-policy|services|terms)/?$ pages/$1.php [L,NC]

    # Blogs
    RewriteRule ^(blogs|blog_post)/?$ blogs/$1.php [L,NC]

    # Courses
    RewriteRule ^(courses|course_detail|course_progress|course_thank_you|manage_courses)/?$ courses/$1.php [L,NC]

    # Projects
    RewriteRule ^(edit_project|project_add|project_details|project_request_popup|project_request_submission)/?$ projects/$1.php [L,NC]

    # --------------------------------------------------------------
    # 3. Fallback: strip .php extension for any other root files
    # --------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L]

    # --------------------------------------------------------------
    # 4. Custom error pages
    # --------------------------------------------------------------
    ErrorDocument 404 /graphicafix/404.php
    ErrorDocument 403 /graphicafix/403.php

</IfModule>

# --------------------------------------------------------------
# GZIP Compression
# --------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>

# --------------------------------------------------------------
# Browser Caching
# --------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css   "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
