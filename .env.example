# ==========================================
# Graphicafix Environment Configuration
# ==========================================

# Database Configuration
DB_SERVER=localhost
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name

# Safepay API (Sandbox / Production)
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=your_safepay_api_key

# JazzCash API (Sandbox / Production)
JAZZCASH_ENVIRONMENT=sandbox
JAZZCASH_MERCHANT_ID=your_merchant_id
JAZZCASH_PASSWORD=your_password
JAZZCASH_INTEGRITY_SALT=your_salt

# Application URLs
PORTAL_URL=https://yourdomain.com/portal/
MAIN_SITE_URL=https://yourdomain.com/
